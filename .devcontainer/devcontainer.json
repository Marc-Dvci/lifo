{
  "name": "LIFO",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup bash -c 'APP_DEMO=1 python -m uvicorn app.server:app --host 0.0.0.0 --port 8787 > /tmp/demo.log 2>&1 &'",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "LIFO demo",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
